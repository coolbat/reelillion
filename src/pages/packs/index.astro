---
import Layout from '../../layouts/Layout.astro';
const packs = [
 {slug:'oscars', icon:'✦', title:'The Oscar shelf', label:'Oscars', text:'Big nights, small surprises. A future collection for awards-season obsessives.'},
 {slug:'horror', icon:'☾', title:'After midnight', label:'Horror', text:'From familiar nightmares to the films you found on a dusty bottom shelf.'},
 {slug:'disney', icon:'✧', title:'Once upon a reel', label:'Disney', text:'A future screening of animated favorites and less obvious family films.'},
 {slug:'anime', icon:'◎', title:'Beyond the frame', label:'Anime', text:'A planned journey through Japanese animated cinema, one deep cut at a time.'},
 {slug:'90s', icon:'▤', title:'Be kind. Rewind.', label:'The 90s', text:'Video-store discoveries, cult favorites and a whole decade to remember.'},
];
---
<Layout title="Reelillion theme packs · A collection for every film fan" description="Explore upcoming Reelillion movie trivia theme packs: Oscars, Horror, Disney, Anime and 90s cinema. Full themed screenings are in development.">
  <article class="content-page"><p class="eyebrow">Coming attractions</p><h1 class="page-title">Find your<br />kind of cinema.</h1><p class="lede">Five collections on the drawing board. Pick your favorite and see what's in the works.</p>
    <div class="packs-list">{packs.map((pack, index) => <a class="pack-row" href={`/packs/${pack.slug}/`}><span class="pack-symbol" aria-hidden="true">{pack.icon}</span><div><span class="eyebrow">Collection {String(index + 1).padStart(2,'0')} · {pack.label}</span><h2>{pack.title}</h2><p>{pack.text}</p></div><span class="pack-status">In development <span aria-hidden="true">↗</span></span></a>)}</div>
    <div class="prose"><p>These are planned collections, not products currently on sale. In the meantime, <a href="/?mode=practice">play a free practice screening</a> from our main catalog.</p></div>
  </article>
</Layout>
<style>
  .packs-list{margin-block:3rem;border-top:1px solid #f5efdf26}.pack-row{display:grid;grid-template-columns:4rem 1fr auto;gap:1.5rem;align-items:center;padding:2rem 0;border-bottom:1px solid #f5efdf26;color:inherit;text-decoration:none}.pack-row h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(1.4rem,3vw,1.9rem);margin-block:.6rem}.pack-row p{max-width:35rem;line-height:1.65;font-size:.95rem;opacity:.75}.pack-symbol{font-size:3rem;color:#afd5c4;transition:transform .2s ease}.pack-row:hover .pack-symbol{transform:rotate(-8deg)}.pack-status{font-size:.75rem;white-space:nowrap;color:#f27665}.pack-row:focus-visible{outline:2px solid #afd5c4;outline-offset:6px}@media(max-width:640px){.pack-row{grid-template-columns:2.5rem 1fr;gap:1rem}.pack-symbol{font-size:2.3rem}.pack-status{grid-column:2}.pack-row .eyebrow{font-size:.6rem}}@media(prefers-reduced-motion:reduce){.pack-symbol{transition:none}.pack-row:hover .pack-symbol{transform:none}}
</style>
